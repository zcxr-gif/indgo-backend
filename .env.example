# ---------------------------------------------------------------------------
# Environment configuration (copy to .env and fill in). .env is gitignored.
# ---------------------------------------------------------------------------

# Core
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://user:pass@cluster/db

# Staff portal authentication (staffAuth.js)
# JWT_SECRET signs staff session cookies — set a long random string and keep it
# stable, or staff get logged out on every restart.
JWT_SECRET=change-me-to-a-long-random-string
# First admin: created automatically on startup ONLY when no staff users exist.
# After the first login, manage staff from the /staff portal and you can remove
# these (the account persists in the database).
STAFF_BOOTSTRAP_USERNAME=admin
STAFF_BOOTSTRAP_PASSWORD=change-me-strong-password
STAFF_BOOTSTRAP_NAME=Site Admin

# AWS S3 (aircraft / airport / VA imagery)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_WEBHOOK_URL=

# Public origin of this site, used to reference our own static assets (e.g. the
# brand logo shown in flight-event webhook cards). Defaults to https://inflight.info.
PUBLIC_BASE_URL=https://inflight.info
# Optional Mapbox token for the LIGHT route map embedded in takeoff/landing
# webhook cards. With a token the card draws departure → arrival as a clean line
# with A/B pins (plus the live aircraft position), auto-framed on Mapbox's
# light-v11 style. When unset, it falls back to a key-less OpenStreetMap (mapnik)
# map with markers. A read-scoped public token (pk.…) is sufficient.
MAPBOX_STATIC_TOKEN=

# VA takeoff/landing events (receiver for POST /api/va-events)
# The ACARS backend POSTs one event per takeoff and per landing here. Set
# VA_BOT_FORWARD_TOKEN to the SAME long random secret configured on the sender
# so inbound requests are checked against `Authorization: Bearer <token>`. Leave
# blank to accept unauthenticated posts (only safe behind a trusted network).
VA_BOT_FORWARD_TOKEN=
# Optional: dedicated Discord webhook for the CENTRAL flight-events feed (every
# VA's takeoffs/landings). Falls back to DISCORD_WEBHOOK_URL above when unset.
# Separately, each partner VA can REQUEST its OWN Discord webhook in the VA
# Partnership Portal to receive just its own flights; a staff member approves the
# VA (VA editor → "Flight events approved") before anything is delivered. That's
# stored per-VA in the database (no env var) and sent in addition to this feed.
VA_EVENTS_DISCORD_WEBHOOK_URL=
# Discord channel ID that VA Partnership Portal activity is logged to (requests,
# approvals, profile edits, etc.). Portal activity is NOT saved to the database —
# it is posted to this channel by the bot. Defaults to a built-in channel ID if
# unset; the bot must be in that server with permission to post.
VA_PORTAL_LOG_CHANNEL_ID=

# VA Partnership Portal (vaPortal.js)
# Partner VAs get a self-service portal account provisioned automatically when
# their VA is approved by the bot. Portal sessions are signed with JWT_SECRET
# above (namespaced so they can't be used as staff sessions). Set VA_PORTAL_URL
# to the public login URL the bot DMs to a VA owner on approval.
VA_PORTAL_URL=https://inflight.info/va-portal
