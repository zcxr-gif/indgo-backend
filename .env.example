# ---------------------------------------------------------------------------
# Environment configuration (copy to .env and fill in). .env is gitignored.
# ---------------------------------------------------------------------------

# Core
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://user:pass@cluster/db

# Staff portal authentication (staffAuth.js)
# JWT_SECRET signs staff session cookies — set a long random string and keep it
# stable, or staff get logged out on every restart.
JWT_SECRET=change-me-to-a-long-random-string
# First admin: created automatically on startup ONLY when no staff users exist.
# After the first login, manage staff from the /staff portal and you can remove
# these (the account persists in the database).
STAFF_BOOTSTRAP_USERNAME=admin
STAFF_BOOTSTRAP_PASSWORD=change-me-strong-password
STAFF_BOOTSTRAP_NAME=Site Admin

# AWS S3 (aircraft / airport / VA imagery)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_WEBHOOK_URL=

# Community aircraft submissions from the browser (POST /api/community/aircraft/submit).
# The submitting site is trusted by its Origin — no shared secret. Comma-separated
# allow-list; entries may use `*` as a wildcard matching one host segment (so
# `deploy-preview-*--indgo-va.netlify.app` matches every numbered Netlify preview).
# A lone `*` accepts any origin. When unset the default covers inflight.info, the
# Netlify production host, its deploy-preview + branch-deploy hosts, and
# PUBLIC_BASE_URL. Photos are uploaded to S3 and routed into the Discord admin
# review flow — staff approve/reject with the existing buttons and only an
# approval writes the record. See EMBEDBACKEND.md for the request contract.
COMMUNITY_SUBMIT_ORIGINS=

# Optional, and the single most useful line in this file if the process is being
# killed: the container's memory cap in MB.
#
# When set, the server does two things past a share of it:
#   85%  logs a loud WARN, turning a silent OOM-kill into a visible pre-crash
#        trail. (Usage is logged every 5 min regardless of this setting.)
#   92%  DROPS the image caches — the route maps and the IFC profile cards. They
#        are pure memos, so this costs one render per hot key and loses nothing,
#        which against being killed is not a close call. It is logged loudly with
#        the figures, because a process shedding every few minutes means either
#        IMAGE_CACHE_MB below is too big for this container or something else in
#        here is growing.
#
# Leave it unset and neither happens: the server has no way to know what it is
# allowed to use, so it cannot tell 400 MB of headroom from 40 MB of danger.
MEMORY_LIMIT_MB=

# Optional: how much memory EACH image cache may retain, in MB. Default 48.
#
# There are two — rendered route maps, and rendered IFC profile cards — and they
# hold PNG Buffers, which live outside the V8 heap where --max-old-space-size
# below cannot reach them. They are bounded in BYTES and not only in entries
# because the values are nowhere near uniform: a route map is flat colour and
# lines, while a profile card carrying a photograph of an aircraft is a lossless
# encoding of a photograph. Measured, 6 KB against 1.1 MB — so a count-only
# ceiling of "200 cards" was anywhere between 1 MB and 200 MB depending purely on
# which pilots had been viewed.
#
# Lower it on a small container (a 512 MB box wants 16–24), raise it on a big one.
IMAGE_CACHE_MB=
#
# IMPORTANT — set a V8 heap ceiling to actually PREVENT the OOM-kill, not just log
# it. V8's default old-space ceiling is far larger than a small container's cap,
# so under load RSS climbs past the cap and the kernel OOM-kills the process
# before V8 ever runs a full GC ("just crashes, no log"). Pin the heap to roughly
# 80% of MEMORY_LIMIT_MB via NODE_OPTIONS so V8 does a full GC before the cap,
# leaving headroom for native (libvips/sharp) memory that lives outside the heap.
# Example for a 512 MB container:
#   NODE_OPTIONS=--max-old-space-size=400
# `npm start` already launches with --expose-gc so the bot's 10-min memory
# janitor can force a GC and hand freed native memory back to the OS.
NODE_OPTIONS=

# Public origin of this site, used to reference our own static assets (e.g. the
# brand logo shown in flight-event webhook cards). Defaults to https://inflight.info.
PUBLIC_BASE_URL=https://inflight.info
# Absolute URL of the Events + Calendar embed widget (embed-events.html). Unlike
# the map embed (fronted by the Netlify site), this widget is served DIRECTLY by
# this backend, so it must point at the backend's own public origin — that way
# the widget's relative /api and /assets calls resolve to the backend. Defaults
# to the backend host; override if the backend URL changes.
EMBED_EVENTS_BASE_URL=https://site--indgo-backend--6dmjph8ltlhv.code.run/embed-events.html
# Optional Mapbox token for the static map image embedded in takeoff/landing
# webhook cards (shows the plane's position with a marker). When unset, the card
# falls back to a key-less OpenStreetMap static map. A read-scoped public token
# (pk.…) is sufficient.
MAPBOX_STATIC_TOKEN=

# VA takeoff/landing events (receiver for POST /api/va-events)
# The ACARS backend POSTs one event per takeoff and per landing here. Set
# VA_BOT_FORWARD_TOKEN to the SAME long random secret configured on the sender
# so inbound requests are checked against `Authorization: Bearer <token>`. Leave
# blank to accept unauthenticated posts (only safe behind a trusted network).
VA_BOT_FORWARD_TOKEN=
# Optional: dedicated Discord webhook for the CENTRAL flight-events feed (every
# VA's takeoffs/landings). Falls back to DISCORD_WEBHOOK_URL above when unset.
# Separately, each partner VA can REQUEST its OWN Discord webhook in the VA
# Partnership Portal to receive just its own flights; a staff member approves the
# VA (VA editor → "Flight events approved") before anything is delivered. That's
# stored per-VA in the database (no env var) and sent in addition to this feed.
VA_EVENTS_DISCORD_WEBHOOK_URL=
# Discord channel ID that VA Partnership Portal activity is logged to (requests,
# approvals, profile edits, etc.). Portal activity is NOT saved to the database —
# it is posted to this channel by the bot. Defaults to a built-in channel ID if
# unset; the bot must be in that server with permission to post.
VA_PORTAL_LOG_CHANNEL_ID=

# VA statistics (vaStats.js)
# Two kinds of number: reach/engagement beaconed by the tracker to
# POST /api/va-stats/track, and flight operations derived from the takeoff/landing
# events above. Both are summarised into one small doc per (day, VA). At the end
# of each day every VA with an APPROVED flight-events webhook gets a daily report
# posted to it, a network-wide report goes to VA_EVENTS_DISCORD_WEBHOOK_URL (or
# DISCORD_WEBHOOK_URL), and that day's raw takeoff/landing rows are then DELETED —
# only the per-day totals are retained.
#
# Shift the day boundary off UTC, in minutes (e.g. -480 runs the "day" on UTC-8,
# so the report fires at local midnight instead). Default 0 = UTC.
VA_STATS_TZ_OFFSET_MINUTES=
# How long the per-day SUMMARIES are kept, in days (TTL). Default 120. The raw
# takeoff/landing rows are not covered by this — they are erased every night.
VA_STATS_RETENTION_DAYS=
# Backstop TTL on the raw takeoff/landing rows, in hours (default 72). The nightly
# report deletes them explicitly; this only matters if a rollup never runs.
VA_STATS_LEG_TTL_HOURS=
# Set to false to stop POSTING the end-of-day reports. Counting, the daily
# summaries and the nightly erase all still happen.
VA_STATS_DAILY_REPORTS=
# Per-IP ceiling on the public tracking beacon, requests/minute (default 240).
VA_STATS_TRACK_LIMIT=

# Group flights (vaGroupFlights.js)
# A VA owner selects the aircraft flying their event and mints ONE short link to
# share — https://inflight.info/?g=<code>. /g/<code> on THIS backend serves the
# same group as an Open Graph preview page so a paste on the IFC or Discord
# unfurls, then redirects a human to the tracker. No serverless function needed.
#
# Who may publish is decided by the contact email already on file for the
# partnership (contactEmail on the VA listing): sign in to Inflight with that
# address and the account is bound to the VA, one account per VA. The email is
# verified by handing the caller's Supabase access token to Supabase itself —
# these two point at the tracker's project and both default to its public
# values, so they only need setting if that project ever moves.
INFLIGHT_SUPABASE_URL=
INFLIGHT_SUPABASE_ANON_KEY=
# How long a published group link stays alive, in days (default 30). Group
# flights are for an event happening now, not an archive — they self-delete.
VA_GROUP_TTL_DAYS=

# Crew data store (crewStore.js)
# A VA's crew data — roster, hours, flight reports, applications and applicant
# emails — lives in the VA's OWN Supabase project, not ours. We keep only their
# staff logins and their directory/branding metadata. Each VA supplies their
# project URL and keys through Crew Center → Settings → Data store; those are
# stored per-VA on the listing, so there is nothing to configure globally here.
# The VA installs supabase/crew-center-schema.sql in their project once.
#
# 'false' lets a VA with no connected project keep using our managed
# collections indefinitely. The default enforces the policy: a VA with no
# project and no pre-existing rows cannot store crew data with us. Leave unset
# unless you are deliberately reopening managed storage.
CREW_STORE_REQUIRE_OWN=
# Per-request timeout when talking to a VA's project, in ms (default 8000).
CREW_STORE_TIMEOUT_MS=

# Encryption at rest for the VA secrets we hold (crewSecrets.js) — today, the
# Supabase access token a VA CHOOSES to let us keep so later schema updates need
# no second trip to supabase.com. AES-256-GCM; the key lives here and never in
# the database, so a dump of the collection is ciphertext.
#
# 32 random bytes as hex is the intended form:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A passphrase of 16+ characters also works (scrypt-stretched). Unset, this
# falls back to JWT_SECRET so an existing deployment gets sealing with no new
# configuration; with NEITHER set, the crew center simply does not offer to
# remember a token and every schema update asks for one, as it always did.
#
# ROTATING IT is safe but lossy: sealed tokens stop opening, the dashboard says
# so, and each VA re-saves theirs. Nothing else in the database is affected.
CREW_SECRET_KEY=

# The ceiling the crew center's Storage screen measures a VA's project against,
# in MB (default 500 — Supabase's free-plan database allowance). Purely a
# reference line for the usage bar: nothing enforces it, Supabase's real limit
# comes from the VA's own plan, and the screen labels it as an assumption. Raise
# it if your VAs are typically on a paid plan.
CREW_STORAGE_LIMIT_MB=

# ---------------------------------------------------------------------------
# Infinite Flight Live — PublicApi v3 (OAuth2)
#
# Lets a VA connect their Live ORGANIZATION to their crew center: the aircraft
# they actually own, where each one is, and the schedule each aircraft will fly.
# See ifOAuth.js / ifLive.js and the "Infinite Flight Live" section of
# supabase/README.md.
#
# NONE OF THIS IS REQUIRED. With it all unset the feature simply is not offered
# — the crew center works exactly as it did. Two things gate it:
#
#   * CREW_SECRET_KEY above MUST be set. The OAuth grant is sealed at rest with
#     it, and the connect flow refuses to start without one rather than sending
#     a VA through consent and then dropping the token. (This is checked before
#     the redirect, not after.)
#   * an OAuth client has to exist — normally the platform one below.
#
# WHOSE CLIENT. Ours. SET THIS. Every crew center signs in through the platform
# client and the VA is identified by the `state`, so nobody has to register an
# application to press a sign-in button. A VA may still register their own in
# the crew center, but it is an override for the few who want one rather than
# the path everybody walks.
#
# Left blank, there is no client at all: the connect route refuses to start and
# says an administrator has to configure it, and only a VA who has registered
# their own can sign in. That was the arrangement while our client waited on
# Infinite Flight's review — "testing clients are limited to the owner and
# invited test users until the app is reviewed and approved" — and it is not
# the arrangement any more.
#
# WORTH KNOWING: if the client named here is not approved for general use,
# every VA fails the same way at once, with "The specified 'client_id' is
# invalid" or a 403 they cannot act on. Boot logs the client in use; the
# connect route logs it per VA.
IF_OAUTH_CLIENT_ID=
# Present -> confidential client (we exchange the code with a secret).
# Absent  -> public client, PKCE only. Both are supported; PKCE is used either
# way, because the preview requires it of both client types.
IF_OAUTH_CLIENT_SECRET=

# Where Infinite Flight sends the browser back. ONE URI for the whole platform
# — it must match what is registered on the OAuth client character for
# character, and a per-VA URI would mean every VA editing their client. The VA
# is carried in the OAuth `state` instead.
#
# SET THIS. It is deliberately NOT derived from PUBLIC_BASE_URL: that variable
# is the SITE (inflight.info, where the crew center is served from) and this
# callback lives on the API server, which is a different host with no /api proxy
# in front of it. Deriving it would produce a confident-looking URI that routes
# nowhere, and Infinite Flight would report it as a redirect_uri mismatch —
# about the least diagnosable error in OAuth.
#
#   IF_OAUTH_REDIRECT_URI=https://<this-api-host>/api/crew/if/callback
#
# THE PATH IS `/api/crew/if/callback` AND NOTHING ELSE. It is the only callback
# route this server has, and there is no redirect from any near miss — a URI
# that points at, say, /api/crew/if-org/callback matches nothing, falls through
# to the SPA, and answers Infinite Flight's redirect with the aircraft app.
# Nothing breaks loudly; the sign-in just never completes. The server warns at
# boot if this variable does not end in that path, and the API answers a
# near-miss callback with a 404 that names the right one.
#
# Left blank, the server falls back to the requesting host, which works for
# local development but is a value a proxy can influence — so set it in
# production. Must be https (localhost excepted); the connect route refuses
# otherwise rather than sending a VA to a consent screen that cannot come back.
#
# Whatever this resolves to is shown on the crew center's connect screen, so a
# VA registering their own client pastes exactly the right string.
IF_OAUTH_REDIRECT_URI=

# The API's own addresses. Overridable because Infinite Flight ships v3 as a
# preview and says its paths may move before general availability — this is the
# difference between changing one value and waiting for a deploy on the day
# they do. Leave blank for the documented defaults:
#   IF_OAUTH_BASE_URL   https://api.infiniteflight.com/auth/v2
#   IF_V3_BASE_URL      https://api.infiniteflight.com/public/v3
#   IF_OAUTH_ISSUER     https://auth.infiniteflight.com/   (where the USER signs
#                       in; we never call it, it is shown on the connect screen)
IF_OAUTH_BASE_URL=
IF_V3_BASE_URL=
IF_OAUTH_ISSUER=

# How long to wait on one Infinite Flight request, in ms (default 15000).
IF_API_TIMEOUT_MS=

# Pilot invitations (crewInvite.js)
# Accepting an applicant mints a temporary password, and that password is kept
# readably on the application row in the VA's OWN project until it is used —
# staff usually hand it over later, by hand, on the IFC or Discord, and the
# applicant's status link is the one channel that reliably reaches them.
#
# It self-destructs: cleared the moment the pilot signs in, when staff discard
# the invitation, or after this many days (default 30). Shorten it if you would
# rather unused invitations lapse sooner; there is no way to disable the
# expiry, and nothing here changes where the ACCOUNT's credential lives (a
# bcrypt hash in crew_accounts, as always).
CREW_INVITE_TTL_DAYS=

# VA Partnership Portal (vaPortal.js)
# Partner VAs get a self-service portal account provisioned automatically when
# their VA is approved by the bot. Portal sessions are signed with JWT_SECRET
# above (namespaced so they can't be used as staff sessions). Set VA_PORTAL_URL
# to the public login URL the bot DMs to a VA owner on approval.
VA_PORTAL_URL=https://inflight.info/va-portal

# ---------------------------------------------------------------------------
# VA websites (vaSites.js, vaSiteBuilder.js)
# ---------------------------------------------------------------------------
# A virtual airline builds a public website in their crew centre and we serve
# it. NONE OF THIS IS REQUIRED: with everything below unset, a published site is
# served at PUBLIC_SITE_ORIGIN/va/<slug>, proxied to this backend from the
# tracker exactly as /pilot/<handle> is, and the builder works in full.
#
# What VA_SITES_DOMAIN adds is an address of the airline's OWN — and one thing
# that cannot work without it: a VA writing their site as files. Their files
# contain their JavaScript, and their JavaScript may not run on the platform's
# origin, which is what the /va/<slug> address is. So on a deployment with no
# subdomains, "write the files yourself" is refused and says why.
#
# The domain every VA site is served under, as <slug>.<this> — so British
# Airways Virtual, whose crew centre address is "ba", gets ba.<this>. The
# airline's own name is the part that identifies it, which is the point.
#
# Requires a wildcard DNS record for *.<this> pointing at this backend, and a
# wildcard TLS certificate for it.
#
# USE A LABEL OF OUR OWN DOMAIN, NOT THE APEX: vasites.inflight.info, not
# inflight.info. Both work, but a dedicated label means a VA's address can never
# collide with a hostname the platform wants later, and the wildcard certificate
# covers *.vasites.inflight.info rather than every name we own.
#
# What sharing a domain with the platform costs, and where it is paid:
#   · A VA's script runs on a subdomain of ours, so it could set a cookie at the
#     parent domain that shadows a session cookie. Closed by the __Host- prefix
#     on every session cookie this platform issues (setAuthCookie in vaPortal.js
#     and staffAuth.js) — the browser refuses to let any subdomain set one.
#     That prefix needs Secure, which needs NODE_ENV=production; the boot log
#     complains if VA sites are hosted without it.
#   · A VA slug becomes one of our hostnames, so www / api / login / mail and
#     their kind must never be VA sites. RESERVED_LABELS in vaSites.js refuses
#     them at the host, and a VA whose slug is one is told so in the editor.
VA_SITES_DOMAIN=

# Script CDNs a hosted site may load from, space separated. Not a control that
# protects us — origin separation does that — but it keeps a tampered site with
# fewer places to phone home from, and makes "can I use Tailwind" a yes rather
# than a support ticket. Default:
#   https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://cdn.tailwindcss.com
VA_SITES_SCRIPT_CDNS=

# Frames a hosted site may open, space separated — the social embeds a VA
# actually uses. Default:
#   https://www.instagram.com https://www.youtube.com https://www.youtube-nocookie.com https://player.twitch.tv https://discord.com
VA_SITES_FRAME_SRC=

# Where a hosted site's crew-feed.js and the crew centre it links to live
# (default https://inflight.info), and where this backend answers from. Both
# are written into every published page and into the sites' CSP, so they have
# to be the addresses the public actually uses, not an internal one.
PUBLIC_SITE_ORIGIN=
PUBLIC_BACKEND_ORIGIN=
